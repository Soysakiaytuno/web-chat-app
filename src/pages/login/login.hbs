{{#> auth-layout title="Iniciar Sesión"}}
  <form class="login-form">
    {{> input name="login" label="Usuario" type="text" placeholder="Ingresa tu usuario"}}
    {{> input name="password" label="Contraseña" type="password" placeholder="Ingresa tu contraseña"}}
    
    <div class="login-form__actions">
      {{> button text="Entrar" type="primary" htmlType="submit"}}
      <a href="/register" class="button button--link">Crear cuenta</a>
    </div>
  </form>
{{/auth-layout}}