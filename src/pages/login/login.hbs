{{#> auth-layout title="Iniciar Sesión"}}
  <form class="login-form">
    <div data-layout="input-login"></div>
    <div data-layout="input-password"></div>
    
    <div class="login-form__actions">
      <!-- Cambiamos enlace por un botón real tipo submit -->
      <button class="button button--primary" type="submit">Entrar</button>
      <a href="/register" class="button button--link">Crear cuenta</a>
    </div>
  </form>
{{/auth-layout}}