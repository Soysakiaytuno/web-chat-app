{{#> auth-layout title="Crear Cuenta"}}
  <form class="login-form">
    <div data-layout="input-email"></div>
    <div data-layout="input-login"></div>
    <div data-layout="input-first-name"></div>
    <div data-layout="input-last-name"></div>
    <div data-layout="input-phone"></div>
    <div data-layout="input-password"></div>
    
    <div class="login-form__actions">
      <button class="button button--primary" type="submit">Registrarse</button>
      <a href="/" class="button button--link">Ya tengo cuenta</a>
    </div>
  </form>
{{/auth-layout}}