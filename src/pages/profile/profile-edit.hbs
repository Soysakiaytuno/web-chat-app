<div class="profile-layout">
  <aside class="profile-layout__sidebar">
    <a href="/profile" class="button button--primary">⬅ Volver</a>
  </aside>
  <main class="profile-layout__content">
    <div class="profile-card">
      <div class="profile-card__avatar"></div>
      <form class="profile-form">
        {{> input name="email" label="Correo" type="email" placeholder="correo@ejemplo.com"}}
        {{> input name="login" label="Usuario" type="text" placeholder="mijael123"}}
        {{> input name="first_name" label="Nombre" type="text" placeholder="Mijael"}}
        {{> input name="last_name" label="Apellido" type="text" placeholder="Ander"}}
        {{> input name="phone" label="Teléfono" type="tel" placeholder="+123456789"}}
        {{> button text="Guardar Cambios" type="primary" htmlType="submit"}}
      </form>
    </div>
  </main>
</div>