<div class="profile-layout">
  <aside class="profile-layout__sidebar">
    <a href="/profile" class="button button--primary">⬅</a>
  </aside>
  <main class="profile-layout__content">
    <div class="profile-card">
      <div class="profile-card__avatar"></div>
      <form class="profile-form">
        <div data-layout="input-email"></div>
        <div data-layout="input-login"></div>
        <div data-layout="input-first-name"></div>
        <div data-layout="input-last-name"></div>
        <div data-layout="input-phone"></div>
        <button class="button button--primary" type="submit">Guardar Cambios</button>
      </form>
    </div>
  </main>
</div>