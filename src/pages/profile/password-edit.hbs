<div class="profile-layout">
  <aside class="profile-layout__sidebar">
    <a href="/profile" class="button button--primary">⬅ Volver</a>
  </aside>
  <main class="profile-layout__content">
    <div class="profile-card">
      <form class="profile-form">
        {{> input name="oldPassword" label="Contraseña Actual" type="password" placeholder="••••••••"}}
        {{> input name="newPassword" label="Nueva Contraseña" type="password" placeholder="••••••••"}}
        {{> input name="newPasswordConfirm" label="Confirmar Nueva Contraseña" type="password" placeholder="••••••••"}}
        {{> button text="Actualizar Contraseña" type="primary" htmlType="submit"}}
      </form>
    </div>
  </main>
</div>