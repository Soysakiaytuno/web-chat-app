<div class="profile-layout">
  <aside class="profile-layout__sidebar">
    <a href="/chat" class="button button--primary">⬅</a>
  </aside>
  <main class="profile-layout__content">
    <div class="profile-card">
      <div class="profile-card__avatar"></div>
      <h2 class="profile-card__name">{{first_name}} {{last_name}}</h2>
      
      <div class="profile-card__info">
        <p><strong>Email:</strong> {{email}}</p>
        <p><strong>Usuario:</strong> {{login}}</p>
        <p><strong>Teléfono:</strong> {{phone}}</p>
      </div>
      <div class="profile-card__actions">
        <a href="/profile-edit" class="button button--link">Editar Perfil</a>
        <a href="/password-edit" class="button button--link">Cambiar Contraseña</a>
        <a href="/" class="button button--link" style="color: var(--error-color);">Cerrar Sesión</a>
      </div>
    </div>
  </main>
</div>